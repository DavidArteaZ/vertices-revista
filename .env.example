# Copia esto a .env en la raíz del repo y rellena los valores.
#
# La app de Next vive en web/ y sólo lee variables desde ahí, así que
# web/.env.local es un enlace simbólico a este archivo:
#
#     ln -sfn ../.env web/.env.local
#
# Un solo archivo, un solo lugar donde rotar una clave.

# Panel del proyecto → Settings → API. Secreta: salta RLS por completo.
# Sólo la tocan las rutas de servidor; jamás debe acabar en un bundle de
# cliente, y por eso ninguna de estas variables lleva el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# No secretas. La clave publicable está pensada para exponerse; aquí no se
# expone porque el navegador nunca habla con Supabase directamente (spec §4.2):
# sube a una URL firmada que le entrega POST /api/uploads.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# https://resend.com/api-keys — acuse de recibo del folio al autor.
RESEND_API_KEY=

# Secreto del cron de mantenimiento (web/vercel.json). Vercel lo manda como
# Authorization: Bearer <valor>. Sin él la ruta responde 401 y no barre nada:
# un endpoint de mantenimiento abierto por olvido es peor que no tenerlo.
#   openssl rand -hex 32
CRON_SECRET=

# Remitente de ese acuse. Con onboarding@resend.dev sólo se puede enviar a la
# dirección dueña de la cuenta de Resend; para producción hace falta un dominio
# verificado.
CORREO_REMITENTE=Revista Vértices <onboarding@resend.dev>
