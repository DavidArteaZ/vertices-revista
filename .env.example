# Copia esto a .env en la raíz del repo y rellena los valores.
#
# La app de Next vive en web/ y sólo lee variables desde ahí, así que
# web/.env.local es un enlace simbólico a este archivo:
#
#     ln -sfn ../.env web/.env.local
#
# Un solo archivo, un solo lugar donde rotar una clave.

# Panel del proyecto → Settings → API. Secreta: salta RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# No secretas. El navegador nunca habla con Supabase directamente: sube a una
# URL firmada que le entrega POST /api/uploads.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# https://resend.com/api-keys — correos transaccionales y contactos de autores.
# Hace falta acceso completo: una clave de sólo envío no puede crear contactos.
RESEND_API_KEY=

# Alias (o id) de las dos plantillas publicadas de confirmación, una por idioma.
# El español usa la suya; los otros cinco idiomas usan la inglesa. Ambas deben
# declarar las variables: nombre, genero, seccion, nom_pieza y folio, y deben
# estar publicadas: una en borrador no se puede mandar.
RESEND_CONFIRMACION_TEMPLATE_ES=confirmacion_es
RESEND_CONFIRMACION_TEMPLATE_ENG=confirmacion_eng

# Id de la lista «Autores» en Resend (Audiences). Sin ella no se guarda ningún
# contacto: acabarían en la lista de por defecto, que nadie consulta.
RESEND_LISTA_AUTORES=

# Firma de los webhooks de Resend (entrega y rebote → envio_eventos, spec §15).
RESEND_WEBHOOK_SECRET=

# Secreto del cron de mantenimiento (web/vercel.json).
CRON_SECRET=

# Remitente de los correos que NO usan plantilla —dictamen, invitación al
# comité y resumen semanal—. El acuse no lo usa: su remitente vive dentro de la
# plantilla de Resend. Para producción hace falta un dominio verificado.
CORREO_REMITENTE=Revista Vértices <no-reply@vertices-revista.mx>
