{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "i18n:generar": "node scripts/i18n/generar.mjs",
    "i18n:verificar": "node scripts/i18n/verificar.mjs",
    "test": "node scripts/i18n/verificar.mjs && tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e/envio.mjs",
    "baseline": "playwright test capturar-baseline",
    "visual": "playwright test paridad",
    "panel": "playwright test --config playwright.panel.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "next": "16.3.1",
    "next-intl": "^4.13.7",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.21.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.17",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pngjs": "^7.0.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "chrome >= 111",
    "safari >= 16.4",
    "firefox >= 128",
    "edge >= 111"
  ],
  "overrides": {
    "uuid": "^11.1.1"
  }
}
